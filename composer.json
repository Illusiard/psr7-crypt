{
    "name": "illusiard/psr7-crypt",
    "description": "PSR-7 stream decorators for WhatsApp-compatible media encryption and decryption.",
    "keywords": [
        "psr-7",
        "stream",
        "encryption",
        "whatsapp",
        "sidecar"
    ],
    "type": "library",
    "license": "MIT",
    "require": {
        "php": "^8.5",
        "guzzlehttp/psr7": "^2.8",
        "psr/http-message": "^2.0"
    },
    "require-dev": {
        "phpunit/phpunit": "^11.5"
    },
    "autoload": {
        "psr-4": {
            "Illusiard\\Psr7Crypt\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Illusiard\\Psr7Crypt\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "phpunit"
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
